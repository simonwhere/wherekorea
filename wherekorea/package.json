{
  "name": "wherekorea",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check:data": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-data.mjs",
    "check:operations": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-operations.mjs",
    "check:community-connection": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-community-connection.mjs",
    "check:community-sql": "node scripts/check-community.mjs",
    "check:smoke": "node scripts/smoke-check.mjs",
    "verify": "npm test && npm run lint && npm run typecheck && npm run check:data && npm run build",
    "walk:report": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/walk-metrics-report.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/blob": "2.8.0",
    "leaflet": "1.9.4",
    "next": "^15.5.27",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.21",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    },
    "tailwindcss": {
      "postcss-selector-parser": "7.1.6"
    }
  }
}
