# 둘셋 · 남편 링크 실제 전송(Supabase) — 이 파일을 .env.local로 복사해서 값을 채워요.
#   cp .env.local.example .env.local
# .env.local은 git에 올라가지 않아요(.gitignore). 값을 채팅에 붙여 넣지 마세요.
#
# 두 이름이 모두 있어야 빌드가 Supabase 전송을 써요. 하나라도 비면 모의 전송(이 기기 안)이에요.
# 확인: node scripts/verify-supabase.mjs  (docs/next-a-setup.md §5)
#
# Claude Code 클라우드 환경에서는 이 파일 대신 환경 설정의 환경 변수에 같은 두 이름으로 넣어요
# (새 세션부터 읽혀요). 그 환경의 Network access가 *.supabase.co를 허용해야 해요.

# Supabase → Project Settings → API → Project URL (서울 리전 프로젝트)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co

# Supabase → Project Settings → API → Project API keys → anon public
#   (새 키 체계라면 publishable 키 sb_publishable_… 도 돼요)
# anon(공개) 키만 넣어요. service_role / secret 키는 절대 넣지 않아요 —
# 모든 규칙을 우회하고, NEXT_PUBLIC_ 이름은 빌드 결과(JS)에 그대로 들어가요.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
