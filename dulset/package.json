{
  "name": "dulset",
  "version": "0.1.0",
  "private": true,
  "description": "둘셋 — 임신을 준비하는 부부가 함께 쓰는 앱 (프로토타입)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx --yes serve out",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-content.mjs --summary",
    "test": "node scripts/validate-content.mjs && vitest run",
    "test:unit": "vitest run --project unit",
    "test:components": "vitest run --project components",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "15.5.26",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
